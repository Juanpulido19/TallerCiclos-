Algoritmo Tabla
	Definir cantidadNum , num Como Entero
	
	Imprimir "Ingrese cantidad de numeros: "
	
	
	Repetir
		leer cantidadNum
	Hasta Que (cantidadNum > 0) 
	
	Para num = 1 Hasta cantidadNum Con Paso 1 Hacer
		Imprimir num , " ", num * num, " ",(num + num * num) 
		
		
	Fin Para
FinAlgoritmo
